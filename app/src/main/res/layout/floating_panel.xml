<!-- app/src/main/res/layout/floating_panel.xml -->
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#CC000000"
    android:padding="8dp"
    android:elevation="8dp">

    <!-- Drag handle -->
    <LinearLayout
        android:id="@+id/dragHandle"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:background="#33FFFFFF"
        android:gravity="center"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⠿ ChessGhost"
            android:textColor="#00FF88"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="6dp"/>

    <!-- FEN input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FEN Position:"
        android:textColor="#888888"
        android:textSize="10sp"/>
    <EditText
        android:id="@+id/fenInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="paste FEN here"
        android:textColor="#FFFFFF"
        android:textColorHint="#555555"
        android:textSize="10sp"
        android:background="#22FFFFFF"
        android:padding="6dp"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:maxLines="2"/>

    <View android:layout_width="match_parent" android:layout_height="6dp"/>

    <!-- Board position calibration -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Board position (pixels):"
        android:textColor="#888888"
        android:textSize="10sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="X:" android:textColor="#888888" android:textSize="10sp"/>
        <EditText android:id="@+id/boardX"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#FFFFFF" android:textSize="10sp" android:background="#22FFFFFF"
            android:padding="4dp" android:inputType="number" android:layout_marginStart="4dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="  Y:" android:textColor="#888888" android:textSize="10sp"/>
        <EditText android:id="@+id/boardY"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#FFFFFF" android:textSize="10sp" android:background="#22FFFFFF"
            android:padding="4dp" android:inputType="number" android:layout_marginStart="4dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="  S:" android:textColor="#888888" android:textSize="10sp"/>
        <EditText android:id="@+id/boardSize"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#FFFFFF" android:textSize="10sp" android:background="#22FFFFFF"
            android:padding="4dp" android:inputType="number" android:layout_marginStart="4dp"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="6dp"/>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/analyzeBtn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="ANALYZE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="#00FF88"
            android:textColor="#000000"/>
        <View android:layout_width="6dp" android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/clearBtn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="CLEAR"
            android:textSize="11sp"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="6dp"/>

    <!-- Status -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ready"
        android:textColor="#00FF88"
        android:textSize="11sp"
        android:gravity="center"/>

</LinearLayout>